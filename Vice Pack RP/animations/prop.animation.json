{
  "format_version": "1.8.0",
  "animations": {
    "animation.vice_prop.size": {
      "loop": true,
      "bones": {
        "item": {
          "scale": "q.property('vice:kind') <= 2 || q.property('vice:kind') == 9 ? 0.55 : (q.property('vice:kind') == 3 || q.property('vice:kind') >= 7 ? 0.7 : 0.9)"
        }
      }
    },
    "animation.vice_prop.tilt": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.4,
      "bones": {
        "item": {
          "rotation": {
            "0.0": [
              0,
              0,
              0
            ],
            "0.4": [
              -55,
              0,
              0
            ]
          }
        }
      }
    }
  }
}
