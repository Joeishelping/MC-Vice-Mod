{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "vice:trip_orb",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": ["math.random(-1, 1)", "math.random(-0.3, 1)", "math.random(-1, 1)"]
      },
      "minecraft:particle_initial_speed": 0.25,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(2.0, 3.5)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": ["math.sin(variable.particle_age * 120 + variable.particle_random_1 * 360) * 0.4", 0.05, "math.cos(variable.particle_age * 120 + variable.particle_random_2 * 360) * 0.4"],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.12 + math.sin(variable.particle_age * 360) * 0.05) * math.min(1, (variable.particle_lifetime - variable.particle_age) * 2)",
          "(0.12 + math.sin(variable.particle_age * 360) * 0.05) * math.min(1, (variable.particle_lifetime - variable.particle_age) * 2)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [56, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["variable.tint.r ?? 1", "variable.tint.g ?? 0.5", "variable.tint.b ?? 1", 1]
      }
    }
  }
}
