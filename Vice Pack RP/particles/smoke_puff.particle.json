{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "vice:smoke_puff",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.puff.speed > 0.8 ? 14 : 8"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.puff.direction_x + math.random(-0.15, 0.15)",
          "variable.puff.direction_y + math.random(0.0, 0.25)",
          "variable.puff.direction_z + math.random(-0.15, 0.15)"
        ]
      },
      "minecraft:particle_initial_speed": "variable.puff.speed * math.random(0.6, 1.2)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4, 2.4)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.35,
          0
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-40, 40)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 + variable.particle_age * 0.14",
          "0.06 + variable.particle_age * 0.14"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.82,
          0.82,
          0.84,
          "0.75 * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
