{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "vice:swirl",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.55,
        "surface_only": true,
        "plane_normal": "y",
        "direction": [
          0,
          0.2,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.4)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(variable.particle_random_1 * 360 + variable.particle_age * 300) * 0.55",
          "variable.particle_age * 0.25",
          "math.sin(variable.particle_random_1 * 360 + variable.particle_age * 300) * 0.55"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 * (1 - variable.particle_age / variable.particle_lifetime) + 0.02",
          "0.06 * (1 - variable.particle_age / variable.particle_lifetime) + 0.02"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tint.r ?? 0.7",
          "variable.tint.g ?? 0.4",
          "variable.tint.b ?? 1",
          1
        ]
      }
    }
  }
}
